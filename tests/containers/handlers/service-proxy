#!/usr/bin/env python3
# @ferry.name service-proxy
# @ferry.desc forward one HTTP request to the local service and add its token
import socket
import sys

TOKEN = b"Bearer test-token"
DROPPED = (b"authorization", b"connection", b"host")

stdin = sys.stdin.buffer
head = []
while True:
    line = stdin.readline()
    if not line:
        sys.exit(0)
    if line in (b"\r\n", b"\n"):
        break
    head.append(line)

request_line = head[0]
length = 0
kept = []
for header in head[1:]:
    name, _, value = header.partition(b":")
    name = name.strip().lower()
    if name in DROPPED:
        continue
    if name == b"content-length":
        length = int(value.strip())
    kept.append(header)
body = stdin.read(length) if length else b""

upstream = socket.create_connection(("127.0.0.1", 8080))
upstream.sendall(
    request_line
    + b"Host: 127.0.0.1:8080\r\n"
    + b"Authorization: "
    + TOKEN
    + b"\r\n"
    + b"Connection: close\r\n"
    + b"".join(kept)
    + b"\r\n"
    + body
)
out = sys.stdout.buffer
while True:
    data = upstream.recv(65536)
    if not data:
        break
    out.write(data)
    out.flush()
